{
  "name": "agent-artifacts",
  "version": "0.3.1",
  "description": "A self-hosted place where AI agents publish artifacts over MCP, and people view, comment on and share them in a web UI.",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tim-brand/agent-artifacts.git"
  },
  "homepage": "https://github.com/tim-brand/agent-artifacts",
  "bugs": {
    "url": "https://github.com/tim-brand/agent-artifacts/issues"
  },
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server.ts",
    "start": "node src/server.ts",
    "hash-password": "node src/hash-password.ts",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "@hono/node-server": "^2.1.7",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "diff": "^9.0.0",
    "highlight.js": "^11.12.0",
    "hono": "^4.13.18",
    "marked": "^18.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@types/node": "^24.19.2",
    "typescript": "^7.0.2"
  }
}
