# Copy this file to .env and fill it in. Never commit .env.

# The two addresses the browser uses. Both are an origin: scheme, name and, if it is not the
# default, the port. No trailing slash. They must differ, and the app and Caddy both read them.
#
# Local trial (the defaults below). Browsers resolve *.localhost to your own computer.
APP_ORIGIN=http://localhost:8080
CONTENT_ORIGIN=http://content.localhost:8080
#
# Real domains with HTTPS. Two DNS names pointing at this server. APP_ORIGIN must be https:
# the app refuses to start otherwise (plain http is only accepted for localhost).
# APP_ORIGIN=https://artifacts.example.com
# CONTENT_ORIGIN=https://artifacts-content.example.com

# Signs the links to artifact content. At least 32 characters. Make one with:
#   openssl rand -base64 32
# Keep it the same across restarts: a new one makes open pages need a reload.
SIGNING_SECRET=

# The accounts that may sign in: `email:hash` entries, separated by commas. Make an entry with:
#   docker compose run --rm --no-deps app node src/hash-password.ts you@example.com
# It asks for the password twice and prints the entry. Paste it after the = sign. The entry has no
# $ or spaces, so it needs no quotes. Example with two accounts:
#   AUTH_USERS=you@example.com:scrypt.15.8.3.…,friend@example.com:scrypt.15.8.3.…
AUTH_USERS=
