# Copy this file to .env and fill it in. Never commit .env.

# The two addresses the browser uses. Both are an origin: scheme, name and, if it is not the
# default, the port. No trailing slash. They must differ, and the app and Caddy both read them.
#
# Local trial (the defaults below). Browsers resolve *.localhost to your own computer.
APP_ORIGIN=http://localhost:8080
CONTENT_ORIGIN=http://content.localhost:8080
#
# Real domains with HTTPS. Two DNS names pointing at this server:
# APP_ORIGIN=https://artifacts.example.com
# CONTENT_ORIGIN=https://artifacts-content.example.com

# Signs the links to artifact content. At least 32 characters. Make one with:
#   openssl rand -base64 32
# Keep it the same across restarts: a new one makes open pages need a reload.
SIGNING_SECRET=

# The one sign-in. Use an email address: the app shows this name as the signed-in user.
AUTH_USER=you@example.com

# The bcrypt hash of your password. Make it with:
#   docker run --rm caddy:2 caddy hash-password --plaintext 'your password'
# A hash contains $ characters. Paste it inside SINGLE quotes, exactly as printed:
#   AUTH_HASH='$2a$14$...'
# Compose does not touch the value inside single quotes in a .env file.
AUTH_HASH=
