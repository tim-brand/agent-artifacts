PORT=3000
DATA_DIR=./data
APP_ORIGIN=http://localhost:3000
CONTENT_ORIGIN=http://content.localhost:3000
# At least 32 random bytes; signs content URLs. Changing it breaks every outstanding content link.
SIGNING_SECRET=change-me-change-me-change-me-change-me
# How people sign in: proxy (the default, a sign-in proxy sends the user) or password (built-in).
# AUTH_MODE=proxy
# Local dev only: pretend a sign-in proxy sent this user. Not with AUTH_MODE=password.
# DEV_USER and the change-me secret above are refused outside local development
# (NODE_ENV=production, or an APP_ORIGIN that is not localhost): the app will not start.
DEV_USER=dev@example.com
# Proxy mode: the request headers in which your sign-in proxy sends the user. There is no default:
# without DEV_USER, proxy mode needs AUTH_EMAIL_HEADER. The names differ per proxy (see
# docs/deployment.md); these are the ones of oauth2-proxy. The name header is optional.
# AUTH_EMAIL_HEADER=X-Forwarded-Email
# AUTH_NAME_HEADER=X-Forwarded-Preferred-Username
# Built-in sign-in: AUTH_MODE=password, comment out DEV_USER above, and list the accounts as
# email:hash, separated by commas. Make an entry with: node src/hash-password.ts you@example.com
# AUTH_USERS=you@example.com:scrypt.15.8.3.<salt>.<key>
